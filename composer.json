{
    "name": "rembon/laravel-auditor-filament",
    "description": "Filament panel plugin for Laravel Auditor: browse audit entries and model changes, and add an audit history to any resource.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "audit",
        "audit-trail",
        "laravel-auditor"
    ],
    "homepage": "https://github.com/Rembonnn/laravel-auditor-filament",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "dayCod",
            "email": "alayarahman07@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0",
        "rembon/laravel-auditor": "^3.0@beta"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rembon\\LaravelAuditorFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rembon\\LaravelAuditorFilament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
